NODE_ENV=development
APP_ENV=development
# Optional server-side Stripe Connect platform key. Use the matching test or live environment.
# STRIPE_CONNECT_PLATFORM_KEY=
# Live Stripe Apps OAuth requires all four values and APP_ENV=production.
# STRIPE_OAUTH_LIVE_CLIENT_ID=
# STRIPE_OAUTH_LIVE_PUBLIC_CLIENT_ID=
# STRIPE_OAUTH_LIVE_GCP_PROJECT_ID=
# STRIPE_OAUTH_LIVE_KEY_SECRET_ID=kp-stripe-oauth-developer-<32 lowercase hex characters>
# STRIPE_OAUTH_LIVE_KEY_SECRET_VERSION=
# Set both only when using a Stripe external-test channel for one business.
# STRIPE_OAUTH_LIVE_TEST_CHANNEL=
# STRIPE_OAUTH_LIVE_TEST_BUSINESS_ID=
# Optional staging checkout configuration.
# CHECKOUT_PILOT_CONFIG=
# CHECKOUT_PILOT_WEBHOOK_SECRET=
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql://kuzushi:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@127.0.0.1:55432/kuzushi_pay
TEST_DATABASE_URL=postgresql://kuzushi:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@127.0.0.1:55432/kuzushi_pay_test
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://localhost:5173
PORT=3000
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# MFA is disabled by default and is not yet approved for production.
MFA_ENABLED=false
# MFA_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Password recovery is disabled until SMTP is configured.
PASSWORD_RESET_ENABLED=false
# PASSWORD_RESET_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=YOUR_SENDING_ADDRESS
# SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
# SMTP_FROM=YOUR_SENDING_ADDRESS
# Sandbox OAuth is disabled by default.
STRIPE_OAUTH_SANDBOX_ENABLED=false
STRIPE_OAUTH_SANDBOX_EXCHANGE_ENABLED=false
# Optional staging connection storage. Use a dedicated pre-created secret.
# STRIPE_OAUTH_SANDBOX_TOKEN_SECRET_ID=
# STRIPE_OAUTH_SANDBOX_INSTALL_URL=REPLACE_WITH_STRIPE_EXTERNAL_TEST_URL
# STRIPE_OAUTH_SANDBOX_REDIRECT_URI=https://YOUR_TEST_HOST/api/stripe/oauth/sandbox/callback
