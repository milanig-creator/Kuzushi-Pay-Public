{
  "name": "kuzushi-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23 || >=24.0.0" },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "bootstrap": "tsx apps/api/src/bootstrap.ts",
    "mfa:rotate-key": "tsx apps/api/src/mfa-rotate-key.ts",
    "build": "npm run generate && tsc -p apps/api/tsconfig.json && tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "node apps/api/dist/server.js",
    "test": "vitest run apps/api/src/app.test.ts apps/api/src/config.test.ts apps/api/src/security.test.ts apps/api/src/mfa-factors.test.ts apps/api/src/recovery-mail.test.ts apps/api/src/secrets/google-secret-manager.test.ts apps/api/src/secrets/business-credential-service.test.ts apps/api/src/stripe/verify-account.test.ts apps/api/src/stripe/oauth-sandbox.test.ts apps/api/src/stripe/oauth-sandbox-exchange.test.ts apps/api/src/stripe/oauth-token-rotation.test.ts apps/api/src/stripe/live-oauth-client.test.ts apps/api/src/stripe/sandbox-webhook.test.ts apps/api/src/stripe/embedded-checkout.test.ts apps/api/src/stripe/publish-product.test.ts apps/api/src/stripe/checkout-service.test.ts apps/api/src/stripe/checkout-webhook.test.ts apps/api/src/stripe/checkout-reconciler.test.ts",
    "secrets:check": "tsx apps/api/src/secrets/check.ts",
    "stripe:verify-account": "tsx apps/api/src/stripe/verify-account-cli.ts",
    "stripe:oauth-live-refresh": "node apps/api/dist/stripe/oauth-live-refresh-cli.js",
    "stripe:oauth-live-publish": "node apps/api/dist/stripe/oauth-live-publish-cli.js",
    "stripe:pilot-setup": "node apps/api/dist/stripe/checkout-pilot-setup-cli.js",
    "stripe:recovery-worker": "node apps/api/dist/stripe/checkout-recovery-cli.js",
    "test:db": "vitest run apps/api/src/database.integration.test.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^8.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.0",
    "fast-crc32c": "^2.0.0",
    "helmet": "^8.0.0",
    "i18next": "^25.0.0",
    "nodemailer": "^10.6.0",
    "otplib": "^13.6.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "stripe": "23.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/connect-pg-simple": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/fast-crc32c": "^2.0.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
